{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academic-homepage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "academic-homepage"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "academic-homepage-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false
    }
  },
  "previews": {
    // Preview deployments use their own cache and cannot write to production's.
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "academic-homepage-preview-cache"
      }
    ],
    "images": {
      "binding": "IMAGES"
    },
    "observability": {
      "enabled": true
    }
  }
}
